// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CurrencyCode {
  USD
  CDF
  KES
  UGX
}

enum TransactionStatus {
  INITIATED
  PENDING_COLLECTION
  COLLECTION_SUCCESS
  COLLECTION_FAILED
  PENDING_PAYOUT
  PAYOUT_SUCCESS
  PAYOUT_FAILED
}

enum AuditEventType {
  BUSINESS
  TECHNICAL
}

enum JobType {
  COLLECTION
  PAYOUT
  STATUS_RECHECK
  NOTIFICATION
  RETRY
  ADMIN_ALERT
  RECONCILIATION
}

enum AdminAlertDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum KycTier {
  TIER_0
  TIER_1
  TIER_2
}

enum VerificationStatus {
  PENDING
  TECHNICAL_REVIEW
  HUMAN_REVIEW
  APPROVED
  REJECTED
  ESCALATED
  EXPIRED
}

enum WhatsAppSessionStatus {
  ACTIVE
  WAITING
  CLOSED
}

enum WhatsAppIntent {
  START_TRANSFER
  CONSENT
  CANCEL
  STATUS
  HELP
  UNKNOWN
}

enum WhatsAppLocale {
  EN
  FR
  SW
  UNKNOWN
}

enum NotificationIntentStatus {
  PENDING
  SENT
  FAILED
}

enum PilotControlKey {
  GLOBAL
  INITIATION
  COLLECTION
  PAYOUT
  CORRIDOR_PROVIDER
  NOTIFICATION
}

enum PilotControlState {
  ENABLED
  PAUSED
  PERMANENTLY_STOPPED
}

enum PilotReadinessStage {
  FOUNDATION_COMPLETE
  LOCAL_E2E_COMPLETE
  PILOT_READY
}

enum PilotApprovalRole {
  ENGINEERING
  OPERATIONS
  COMPLIANCE_RISK
  RECONCILIATION
  PILOT_OPERATOR
}

enum ContactChannel {
  WHATSAPP
  SMS
  EMAIL
  MOBILE_APP
}

enum LedgerAccount {
  CUSTOMER_COLLECTION
  PARTNER_CLEARING
  BENEFICIARY_PAYOUT
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum ReconciliationStatus {
  PENDING
  CONSISTENT
  MISSING_COLLECTION_ENTRY
  MISSING_PAYOUT_ENTRY
  MISMATCH
}

enum AdminRole {
  CUSTOMER
  SUPPORT
  OPS
  ADMIN
}

model Corridor {
  id String @id @default(cuid())
  code String @unique
  name String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policies CorridorPolicy[]
  beneficiaries Beneficiary[]
  transactions TransferTransaction[]
  auditEvents AuditEvent[]

  @@index([isActive, code])
}

model CorridorPolicy {
  id String @id @default(cuid()) 
  corridorId String
  version Int 
  isActive Boolean @default(true)
  sendCurrency CurrencyCode
  payoutCurrency CurrencyCode
  collectionTimeoutMinutes Int @default(15)
  payoutTimeoutMinutes Int @default(15)
  minSendAmountMinor BigInt?
  maxSendAmountMinor BigInt?
  rules Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  corridor Corridor @relation(fields: [corridorId], references: [id], onDelete: Restrict)

  @@unique([corridorId, version])
  @@index([corridorId, isActive])
}

model Beneficiary {
  id String @id @default(cuid())
  familyId String @default(cuid())
  corridorId String
  userId String
  displayName String
  payoutCountryCode String
  payoutCurrency CurrencyCode
  phoneNumber String
  payoutAccount Json?
  payoutAccountCiphertext Json?
  version Int @default(1)
  supersedesId String?
  isCurrent Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  corridor Corridor @relation(fields: [corridorId], references: [id], onDelete: Restrict)
  transactions TransferTransaction[] @relation("BeneficiaryTransactions")
  retryTransactions TransferTransaction[] @relation("RetryBeneficiaryTransactions")
  supersedes Beneficiary? @relation("BeneficiaryVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  revisions Beneficiary[] @relation("BeneficiaryVersions")

  @@index([userId, corridorId])
  @@index([corridorId, phoneNumber])
  @@index([userId, corridorId, isCurrent])
  @@unique([familyId, version])
}

model TransferTransaction {
  id String @id @default(cuid())
  reference String @unique
  corridorId String
  senderUserId String
  beneficiaryId String?
  retryBeneficiaryId String?
  status TransactionStatus @default(INITIATED)
  region String?
  partitionKey String?
  sendAmountMinor BigInt
  sendCurrency CurrencyCode
  payoutAmountMinor BigInt?
  payoutCurrency CurrencyCode?
  partnerReference String?
  partnerReferenceBlindIndex String?
  idempotencyKey String @unique
  activeJobKey String?
  collectionRequestAt DateTime?
  collectionCompletedAt DateTime?
  payoutRequestedAt DateTime?
  payoutCompletedAt DateTime?
  failedReason String?
  lastStatusRecheckAt DateTime?
  lastStatusRecheckResult String?
  metadata Json?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  corridor Corridor @relation(fields: [corridorId], references: [id], onDelete: Restrict)
  beneficiary Beneficiary? @relation("BeneficiaryTransactions", fields: [beneficiaryId], references: [id], onDelete: SetNull)
  retryBeneficiary Beneficiary? @relation("RetryBeneficiaryTransactions", fields: [retryBeneficiaryId], references: [id], onDelete: SetNull)
  auditEvents AuditEvent[]
  workerJobs WorkerJob[]
  ledgerEntries LedgerEntry[]
  reconciliation TransactionReconciliation?
  adminNotes AdminNote[]
  notificationIntents NotificationIntent[]

  @@index([corridorId, createdAt])
  @@index([senderUserId, status])
  @@index([status, updatedAt])
}

model WhatsAppSession {
  id String @id @default(cuid())
  chatId String
  senderPhoneNumber String?
  senderPhoneCiphertext String?
  senderPhoneBlindIndex String?
  status WhatsAppSessionStatus @default(ACTIVE)
  locale WhatsAppLocale @default(UNKNOWN)
  consentGivenAt DateTime?
  activeChatKey String? @unique
  transferId String? @unique
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId, status, updatedAt])
}

model WhatsAppInboundEvent {
  id String @id @default(cuid())
  externalEventId String @unique
  chatId String
  senderPhoneNumber String?
  senderPhoneCiphertext String?
  senderPhoneBlindIndex String?
  payloadRedacted Json?
  intent WhatsAppIntent @default(UNKNOWN)
  locale WhatsAppLocale @default(UNKNOWN)
  consentGiven Boolean @default(false)
  receivedAt DateTime @default(now())

  @@index([chatId, receivedAt])
}

model NotificationIntent {
  id String @id @default(cuid())
  dedupKey String @unique
  transactionId String?
  channel ContactChannel
  recipientPhoneCiphertext String?
  template String
  payload Json
  status NotificationIntentStatus @default(PENDING)
  attempts Int @default(0)
  nextAttemptAt DateTime?
  lastError String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction TransferTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt, createdAt])
  @@index([transactionId, createdAt])
}

/// Shared platform identity store used by backend authorization and the self-hosted admin app.
model PlatformIdentity {
  id String @id @default(cuid())
  userId String @unique
  displayName String?
  role AdminRole @default(CUSTOMER)
  totpSecret String?
  hardwareKeyCredentialId String?
  mfaVerifiedAt DateTime?
  blockedAt DateTime?
  blockedReason String?
  blockedById String?
  breakGlassUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AdminSession[]
  notes AdminNote[] @relation("AuthoredAdminNote")
  hardwareKeys HardwareKeyCredential[]
  webAuthnChallenges WebAuthnChallenge[]

  @@index([role, blockedAt])
}

/// Registered WebAuthn hardware authenticators. Public keys and counters never leave the platform.
model HardwareKeyCredential {
  id String @id @default(cuid())
  identityId String
  credentialId String @unique
  publicKey Bytes
  counter Int @default(0)
  transports String[]
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  identity PlatformIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  @@index([identityId])
}

/// Short-lived, single-use server challenges for registration and authentication ceremonies.
model WebAuthnChallenge {
  id String @id @default(cuid())
  identityId String
  challenge String @unique
  ceremony String
  expiresAt DateTime
  createdAt DateTime @default(now())

  identity PlatformIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  @@index([identityId, ceremony, expiresAt])
}

/// Short-lived, hashed sessions. Raw bearer tokens are never stored.
model AdminSession {
  id String @id @default(cuid())
  identityId String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  identity PlatformIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@index([identityId, expiresAt])
}

/// Notes are append-only investigation context. The linked AuditEvent is the immutable accountability record.
model AdminNote {
  id String @id @default(cuid())
  transactionId String?
  reconciliationId String?
  authorIdentityId String
  body String
  createdAt DateTime @default(now())

  transaction TransferTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  reconciliation TransactionReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  author PlatformIdentity @relation("AuthoredAdminNote", fields: [authorIdentityId], references: [id], onDelete: Restrict)

  @@index([transactionId, createdAt])
  @@index([reconciliationId, createdAt])
}

model LedgerEntry {
  id String @id @default(cuid())
  transactionId String
  account LedgerAccount
  direction LedgerDirection
  amountMinor BigInt
  currency CurrencyCode
  eventName String
  createdAt DateTime @default(now())

  transaction TransferTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId, createdAt])
  @@index([account, createdAt])
  @@unique([transactionId, eventName, account, direction])
}

model TransactionReconciliation {
  id String @id @default(cuid())
  transactionId String @unique
  status ReconciliationStatus @default(PENDING)
  reason String?
  transactionStatus TransactionStatus?
  providerStatusSnapshot String?
  providerReferencePresent Boolean @default(false)
  callbackCount Int @default(0)
  lastCallbackAt DateTime?
  discrepancyOwnerIdentityId String?
  escalatedAt DateTime?
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction TransferTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  adminNotes AdminNote[]

  @@index([status, checkedAt])
}

model AuditEvent {
  id String @id @default(cuid())
  eventType AuditEventType
  name String
  actorType String?
  actorId String?
  corridorId String?
  transactionId String?
  payload Json
  createdAt DateTime @default(now())

  corridor Corridor? @relation(fields: [corridorId], references: [id], onDelete: SetNull)
  transaction TransferTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  alertDeliveries AdminAlertDelivery[]

  @@index([transactionId, createdAt])
  @@index([corridorId, createdAt])
  @@index([eventType, createdAt])
}

/// Durable visibility and retry state for sensitive control-plane alerts.
model AdminAlertDelivery {
  id String @id @default(cuid())
  auditEventId String
  actionName String
  payload Json
  severity String @default("URGENT")
  status AdminAlertDeliveryStatus @default(PENDING)
  attempts Int @default(0)
  nextAttemptAt DateTime?
  lastError String?
  deliveredAt DateTime?
  acknowledgedAt DateTime?
  acknowledgedByIdentityId String?
  escalatedAt DateTime?
  escalatedByIdentityId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEvent AuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([auditEventId])
  @@index([acknowledgedAt, escalatedAt])
}

model WorkerJob {
  id String @id @default(cuid())
  dedupKey String @unique
  jobType JobType
  transactionReference String
  transactionId String?
  status JobStatus @default(PENDING)
  payload Json
  attempts Int @default(0)
  lockedAt DateTime?
  leaseExpiresAt DateTime?
  processedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction TransferTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([transactionReference, jobType])
  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
}

model ProcessedJob {
  id String @id @default(cuid())
  transactionReference String
  jobType String
  processedAt DateTime @default(now())

  @@unique([transactionReference, jobType])
}

/// Durable, channel-agnostic sender identity. Email remains optional for WhatsApp onboarding.
model SenderProfile {
  id String @id @default(cuid())
  userId String @unique
  legalName String?
  email String? @unique
  emailCiphertext String?
  emailBlindIndex String? @unique
  senderPhoneNumber String? @unique
  senderPhoneCiphertext String?
  senderPhoneBlindIndex String? @unique
  whatsappPhoneNumber String
  backupPhoneNumber String?
  backupPhoneCiphertext String?
  tier KycTier @default(TIER_0)
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verificationHistory SenderVerification[]
  phoneReplacementHistory SenderPhoneReplacement[]
  contactPreferences ContactPreference?
  channelMigrations ChannelMigration[]
  tierLimitOverride SenderTierLimitOverride?
  pilotAllowlist PilotAllowlist?

  @@index([senderPhoneNumber])
  @@index([tier, createdAt])
}

model PilotControl {
  id String @id @default(cuid())
  key PilotControlKey @unique
  state PilotControlState @default(ENABLED)
  reason String?
  changedByIdentityId String?
  changedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PilotReleaseRecord {
  id String @id @default("pilot")
  stage PilotReadinessStage @default(FOUNDATION_COMPLETE)
  noWaiverConfirmed Boolean @default(false)
  approvedCohort Json?
  numericLimits Json?
  releaseConfiguration Json?
  rollbackPlan String?
  evidenceRefs Json?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals PilotReleaseApproval[]
}

model PilotReleaseApproval {
  id String @id @default(cuid())
  recordId String @default("pilot")
  role PilotApprovalRole
  actorIdentityId String
  note String
  approvedAt DateTime @default(now())

  record PilotReleaseRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)

  @@unique([recordId, role])
  @@index([actorIdentityId, approvedAt])
}

model PilotAllowlist {
  id String @id @default(cuid())
  senderProfileId String @unique
  enabled Boolean @default(true)
  reason String?
  changedByIdentityId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senderProfile SenderProfile @relation(fields: [senderProfileId], references: [id], onDelete: Restrict)
}

model PilotExposurePolicy {
  id String @id @default("pilot")
  allowlistRequired Boolean @default(true)
  maxPendingTransfers Int?
  maxAmbiguousTransfers Int?
  maxPartnerSettlementMinor BigInt?
  maxRecoveryCapacity Int?
  globalDailySendMinor BigInt?
  updatedByIdentityId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PilotExposureSignal {
  id String @id @default(cuid())
  key String @unique
  severity String
  observedValue BigInt
  threshold BigInt
  lastEmittedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Provider-neutral verification cases are immutable evidence; only an approved human review may promote the profile.
model SenderVerification {
  id String @id @default(cuid())
  senderProfileId String
  provider String @default("OPEN_BIOMETRICS")
  providerReference String @unique
  providerReferenceBlindIndex String?
  idempotencyKey String @unique
  status VerificationStatus
  verifiedPhoneNumber String?
  evidenceCiphertext Json?
  failureReason String?
  decisionReason String?
  collectedByIdentityId String?
  reviewerIdentityId String?
  consentAt DateTime?
  reviewedAt DateTime?
  expiresAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())

  senderProfile SenderProfile @relation(fields: [senderProfileId], references: [id], onDelete: Restrict)

  @@index([senderProfileId, createdAt])
  @@index([status, createdAt])
}

model SenderPhoneReplacement {
  id String @id @default(cuid())
  senderProfileId String
  previousPhoneNumber String?
  replacementPhoneNumber String?
  previousPhoneCiphertext String?
  replacementPhoneCiphertext String?
  previousPhoneBlindIndex String?
  replacementPhoneBlindIndex String?
  verificationId String @unique
  replacedAt DateTime @default(now())

  senderProfile SenderProfile @relation(fields: [senderProfileId], references: [id], onDelete: Restrict)

  @@index([senderProfileId, replacedAt])
}

/// Global defaults are intentionally simple rows, suitable for an AdminJS resource.
model TierLimitPolicy {
  id String @id @default(cuid())
  tier KycTier @unique
  perTransferLimitMinor BigInt
  dailyLimitMinor BigInt
  updatedByAdminId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Rare support/admin exception for a single sender; null means use global policy.
model SenderTierLimitOverride {
  id String @id @default(cuid())
  senderProfileId String @unique
  perTransferLimitMinor BigInt?
  dailyLimitMinor BigInt?
  reason String
  updatedByAdminId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senderProfile SenderProfile @relation(fields: [senderProfileId], references: [id], onDelete: Restrict)
}

model ContactPreference {
  id String @id @default(cuid())
  senderProfileId String @unique
  preferredChannel ContactChannel @default(WHATSAPP)
  preferredLanguage String @default("en")
  notificationsOptedIn Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senderProfile SenderProfile @relation(fields: [senderProfileId], references: [id], onDelete: Restrict)
}

/// Explicit record of a profile's migration to a future channel without changing identity shape.
model ChannelMigration {
  id String @id @default(cuid())
  senderProfileId String
  fromChannel ContactChannel @default(WHATSAPP)
  toChannel ContactChannel
  status String @default("PENDING")
  externalReference String?
  migratedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senderProfile SenderProfile @relation(fields: [senderProfileId], references: [id], onDelete: Restrict)

  @@index([senderProfileId, createdAt])
}
