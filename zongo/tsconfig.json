{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["jest"],
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/audit": ["libs/audit/src"],
      "@app/audit/*": ["libs/audit/src/*"],
      "@app/config": ["libs/config/src"],
      "@app/config/*": ["libs/config/src/*"],
      "@app/db": ["libs/db/src"],
      "@app/db/*": ["libs/db/src/*"],
      "@app/domain": ["libs/domain/src"],
      "@app/domain/*": ["libs/domain/src/*"],
      "@app/partner": ["libs/partner/src"],
      "@app/partner/*": ["libs/partner/src/*"],
      "@app/profile": ["libs/profile/src"],
      "@app/profile/*": ["libs/profile/src/*"],
      "@app/beneficiary": ["libs/beneficiary/src"],
      "@app/beneficiary/*": ["libs/beneficiary/src/*"],
      "@app/ledger": ["libs/ledger/src"],
      "@app/ledger/*": ["libs/ledger/src/*"],
      "@app/security": ["libs/security/src"],
      "@app/security/*": ["libs/security/src/*"],
      "@app/whatsapp": ["libs/whatsapp/src"],
      "@app/whatsapp/*": ["libs/whatsapp/src/*"],
      "@app/transfer": ["libs/transfer/src"],
      "@app/transfer/*": ["libs/transfer/src/*"],
      "@app/observability": ["libs/observability/src"],
      "@app/observability/*": ["libs/observability/src/*"]
    }
  },
  "exclude": ["apps/admin-panel"]
}
