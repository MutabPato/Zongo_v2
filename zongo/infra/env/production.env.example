# Values are entered as runtime-only Coolify environment variables, never committed.
NODE_ENV=production
POSTGRES_USER=zongo
POSTGRES_PASSWORD=REPLACE_WITH_SECRET
POSTGRES_DB=zongo
REDIS_PASSWORD=REPLACE_WITH_SECRET
API_HOSTNAME=api.example.com
ADMIN_HOSTNAME=admin.tailnet.example.com
BREAK_GLASS_SECRET=REPLACE_WITH_SECRET
ADMINJS_COOKIE_SECRET=REPLACE_WITH_SECRET
ADMIN_ALERT_WEBHOOK_URL=REPLACE_WITH_SECRET_OR_LEAVE_EMPTY
ADMIN_WARNING_ALERT_WEBHOOK_URL=REPLACE_WITH_WARNING_CHANNEL_OR_LEAVE_EMPTY
METRICS_READ_TOKEN=REPLACE_WITH_INTERNAL_METRICS_TOKEN
PRETIUM_BASE_URL=https://api.pretium.africa
PRETIUM_CONSUMER_KEY=REPLACE_WITH_SECRET
PRETIUM_WEBHOOK_URL=https://api.example.com/webhooks/pretium
PRETIUM_WEBHOOK_SECRET=REPLACE_WITH_SECRET
PRETIUM_CDF_ENABLED=true
PRETIUM_KES_ENABLED=true
PRETIUM_ENVIRONMENT=production
PRETIUM_NO_SANDBOX_CONFIRMED=true
PILOT_RPO_MINUTES=REPLACE_WITH_APPROVED_TARGET
PILOT_RTO_MINUTES=REPLACE_WITH_APPROVED_TARGET
WHATSAPP_RATE_LIMIT_KEY=REPLACE_WITH_INTERNAL_RATE_LIMIT_KEY
WHATSAPP_INGRESS_RATE_LIMIT_PER_MINUTE=30
WEBAUTHN_RP_ID=admin.tailnet.example.com
WEBAUTHN_ORIGIN=https://admin.tailnet.example.com
ADMIN_BOOTSTRAP_EMAIL=admin@zongo.app
ADMIN_BOOTSTRAP_TOTP_SECRET=YOUR_UNIQUE_BASE32_TOTP_SECRET
